# Frontend (public values only - safe to expose; protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side secrets: set with `supabase secrets set` - NEVER put these in a VITE_ variable or commit them.
